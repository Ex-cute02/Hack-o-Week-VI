# Server
PORT=3001
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wearable_iam
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# KMS Simulation (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
MASTER_KEY_HEX=<64-hex-char-master-key>
HMAC_SECRET_HEX=<64-hex-char-hmac-secret>

# JWT
JWT_ISSUER=wearable-iam.local
